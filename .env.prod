# django settings
DEBUG=False
SECRET_KEY="example_secret_key"  # https://stackoverflow.com/a/57678930
ALLOWED_HOSTS="localhost,127.0.0.1"
CSRF_TRUSTED_ORIGINS="http://localhost:8001"

# file storage
STATIC_ROOT="example_static_root"
MEDIA_ROOT="example_media_root"

# database settings
